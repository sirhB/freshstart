# SQLite for local / Phase 0+ development.
# Prefer an absolute path in Cloud Agents so Prisma CLI and Next.js share the same file:
# DB_URL="file:/workspace/prisma/dev.db"
DB_URL="file:./dev.db"

# Render: set DB_URL in the dashboard (or rely on render.yaml default).
# If unset, the app falls back to file:./prisma/prod.db so builds/starts succeed.
# DATABASE_URL is also accepted and aliased to DB_URL.
# For durable data on Render, use a Postgres DB_URL instead of SQLite.
# DATABASE_URL="postgresql://..."
