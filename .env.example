# SQLite for local / Phase 0+ development.
# Prefer an absolute path in Cloud Agents so Prisma CLI and Next.js share the same file:
# DB_URL="file:/workspace/prisma/dev.db"
DB_URL="file:./dev.db"

# On Render (and similar hosts), either set DB_URL directly, or keep their
# injected DATABASE_URL — the app aliases DATABASE_URL → DB_URL at startup.
# DATABASE_URL="postgresql://..."
