generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_URL")
}

model Consumer {
  id           String   @id @default(cuid())
  fullName     String
  addressLine1 String
  cityStateZip String
  dateOfBirth  String?
  phone        String?
  email        String?
  ssnLast4     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reports      CreditReport[]
  cases        DisputeCase[]
  evidence     EvidenceDocument[]
  notifications Notification[]
}

model CreditReport {
  id           String   @id @default(cuid())
  consumerId   String
  consumer     Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  bureau       String?
  reportDate   String
  sourceLabel  String?
  createdAt    DateTime @default(now())
  tradelines   Tradeline[]
}

model Tradeline {
  id              String   @id @default(cuid())
  reportId        String
  report          CreditReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  creditor        String
  accountNumber   String?
  accountType     String
  status          String
  balance         String?
  dateOpened      String?
  dateOfFirstDelinquency String?
  furnisherName   String?
  furnisherAddress String?
  bureausJson     String   // JSON array of bureaus
  rawNotes        String?
  disputeItems    DisputeItem[]
}

model DisputeCase {
  id                     String    @id @default(cuid())
  consumerId             String
  consumer               Consumer  @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  title                  String
  status                 String    @default("draft") // draft | pending_plan_approval | pending_packet_approval | mailing | investigating | closed
  waveNumber             Int       @default(1)
  investigationStartedAt DateTime?
  investigationDueAt     DateTime? // FCRA ~30 day window from delivery
  parentCaseId           String?   // prior wave / reinsertion source
  closedReason           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  items                  DisputeItem[]
  packets                LetterPacket[]
  approvals              ApprovalGate[]
  auditLogs              AuditLog[]
  outcomes               OutcomeEvent[]
  evidence               EvidenceDocument[]
  notifications          Notification[]
  reinsertionChecks      ReinsertionCheck[]
}

/// Scheduled 30/60/90-day reinsertion watchdog checks after a deletion win.
model ReinsertionCheck {
  id          String    @id @default(cuid())
  caseId      String
  case        DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  itemId      String?
  label       String
  dueAt       DateTime
  status      String    @default("scheduled") // scheduled | due | completed | hit | cancelled
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

model OutcomeEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  itemId    String?
  item      DisputeItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  outcome   String   // deleted | corrected | verified | frivolous | no_response | reinserted
  notes     String?
  createdAt DateTime @default(now())
}

model EvidenceDocument {
  id                 String   @id @default(cuid())
  consumerId         String
  consumer           Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  caseId             String?
  case               DisputeCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  itemId             String?
  item               DisputeItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  label              String
  kind               String   // id | address_proof | statement | report_excerpt | response_letter | other
  storageKey         String   // local stub path or object key
  matchedAccountHint String?
  createdAt          DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  caseId     String?
  case       DisputeCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  channel    String   @default("in_app") // in_app | email_stub
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model FurnisherAddress {
  id           String   @id @default(cuid())
  name         String
  addressLines String   // newline-separated
  source       String   @default("manual") // manual | report | crowed
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name])
}

model DisputeItem {
  id               String   @id @default(cuid())
  caseId           String
  case             DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tradelineId      String?
  tradeline        Tradeline? @relation(fields: [tradelineId], references: [id])
  creditor         String
  accountNumber    String?
  accountType      String
  statusReported   String
  balance          String?
  dateOpened       String?
  furnisherName    String?
  furnisherAddress String?
  bureausJson      String
  groundCode       String
  groundRationale  String
  remedy           String   @default("delete") // delete | correct
  correctedValues  String?  // JSON
  confidence       Float
  recommended      Boolean  @default(false)
  status           String   @default("proposed") // proposed | approved | denied | queued | mailed | investigating | resolved_deleted | resolved_corrected | resolved_verified
  evidenceNotes    String?
  riskFlagsJson    String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  outcomes         OutcomeEvent[]
  evidence         EvidenceDocument[]
}

model LetterPacket {
  id               String    @id @default(cuid())
  caseId           String
  case             DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recipientType    String    // cra | furnisher
  recipientName    String
  bureau           String?
  status           String    @default("draft") // draft | pending_approval | approved | denied | queued | mailed | delivered
  bodyText         String
  lintPassed       Boolean   @default(false)
  lintIssuesJson   String    @default("[]")
  itemIdsJson      String    // JSON array of dispute item ids
  trackingNumber   String?
  mailedAt         DateTime?
  deliveredAt      DateTime?
  returnReceiptAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvals        ApprovalGate[]
}

model ApprovalGate {
  id         String   @id @default(cuid())
  caseId     String
  case       DisputeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  packetId   String?
  packet     LetterPacket? @relation(fields: [packetId], references: [id])
  gateType   String   // parse_review | dispute_plan | packet_signoff | mail_exception | outcome_exception | compliance_hold
  status     String   @default("pending") // pending | approved | denied
  actor      String?
  reason     String?
  payloadJson String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  caseId    String?
  case      DisputeCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  action    String
  actor     String
  detailJson String?
  createdAt DateTime @default(now())
}
